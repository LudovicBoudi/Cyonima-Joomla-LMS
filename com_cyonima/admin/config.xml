<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset name="component" label="COM_CYONIMA_CONFIG_COMPONENT_LABEL">
		<field
			name="certificate_path"
			type="text"
			label="COM_CYONIMA_CONFIG_CERTIFICATE_PATH_LABEL"
			description="COM_CYONIMA_CONFIG_CERTIFICATE_PATH_DESC"
			default="images/com_cyonima/certificates"
			filter="string"
		/>
		<field
			name="media_path"
			type="text"
			label="COM_CYONIMA_CONFIG_MEDIA_PATH_LABEL"
			description="COM_CYONIMA_CONFIG_MEDIA_PATH_DESC"
			default="images/com_cyonima"
			filter="string"
		/>
		<field
			name="certificate_prefix"
			type="text"
			label="COM_CYONIMA_CONFIG_CERTIFICATE_PREFIX_LABEL"
			description="COM_CYONIMA_CONFIG_CERTIFICATE_PREFIX_DESC"
			default="CYN"
			filter="string"
		/>
		<field
			name="notify_teacher_on_submission"
			type="radio"
			label="COM_CYONIMA_CONFIG_NOTIFY_LABEL"
			description="COM_CYONIMA_CONFIG_NOTIFY_DESC"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>
</config>
